with "ravenscar_build.gpr";
project Ada_Renode_Rtos is
  for Target use ravenscar_build'Target;
   for Runtime ("Ada") use ravenscar_build'Runtime ("Ada");


   -- Per ora prova questo.
   -- Se poi scopri che il runtime corretto è un altro, cambialo.

   for Main use ("main.adb");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
         ("-mcpu=cortex-m4",
           "-mthumb",
         "-gnat12",
         "-gnatwa",
         "-g",
         "-O2");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-mcpu=cortex-m4",
          "-mthumb");
   end Linker;

   package Builder is
      for Executable ("main.adb") use "ada_renode_rtos";
   end Builder;

end Ada_Renode_Rtos;
