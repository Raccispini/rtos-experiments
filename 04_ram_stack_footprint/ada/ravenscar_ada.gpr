with "config/ravenscar_ada_config.gpr";
with "ravenscar_build.gpr";

project Ravenscar_Ada is
  for Target use ravenscar_build'Target;
   for Runtime ("Ada") use ravenscar_build'Runtime ("Ada");


   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ravenscar_Ada_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("gee.adb");

   package Compiler is
      for Default_Switches ("Ada") use Ravenscar_Ada_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ravenscar_Ada;
