:name: Test1c - campionamento esteso ISR (300 trigger, fasi variate) (Ada)
using sysbus
$name?="jitter_ext_ada"
mach create $name
machine LoadPlatformDescription @nrf52840_legacy_uart.repl
machine LoadPlatformDescriptionFromString "dwt: Miscellaneous.DWT @ sysbus 0xE0001000 { frequency: 64000000 }"
showAnalyzer uart0
sysbus LoadELF @obj/ada_renode_rtos
logLevel -1
start
pause
emulation RunFor "00:00:01"
macro sample0
"""
    sysbus WriteDoubleWord 0xE0001004 0x0
    sysbus WriteDoubleWord 0xE000EF00 0x6
    emulation RunFor "00:00:00.097"
"""
macro sample1
"""
    sysbus WriteDoubleWord 0xE0001004 0x0
    sysbus WriteDoubleWord 0xE000EF00 0x6
    emulation RunFor "00:00:00.135"
"""
macro sample2
"""
    sysbus WriteDoubleWord 0xE0001004 0x0
    sysbus WriteDoubleWord 0xE000EF00 0x6
    emulation RunFor "00:00:00.061"
"""
macro sample3
"""
    sysbus WriteDoubleWord 0xE0001004 0x0
    sysbus WriteDoubleWord 0xE000EF00 0x6
    emulation RunFor "00:00:00.149"
"""
macro sample4
"""
    sysbus WriteDoubleWord 0xE0001004 0x0
    sysbus WriteDoubleWord 0xE000EF00 0x6
    emulation RunFor "00:00:00.023"
"""
runMacro $sample0
runMacro $sample1
runMacro $sample2
runMacro $sample3
runMacro $sample4
runMacro $sample0
runMacro $sample1
runMacro $sample2
runMacro $sample3
runMacro $sample4
